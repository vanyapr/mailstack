+package main
+
+import (
+	"bytes"
+	"encoding/json"
+	"testing"
+
+	"github.com/mjl-/mox/webadmin"
+)
+
+func TestDNSCheckJSONPreservesNativeDiagnostics(t *testing.T) {
+	for _, section := range []string{"MX", "SPF", "DKIM"} {
+		t.Run(section, func(t *testing.T) {
+			result := webadmin.CheckResult{}
+			failure := webadmin.Result{Errors: []string{"missing DNS record"}, Warnings: []string{"native warning"}}
+			switch section {
+			case "MX":
+				result.MX.Result = failure
+			case "SPF":
+				result.SPF.Result = failure
+			case "DKIM":
+				result.DKIM.Result = failure
+			}
+			var output bytes.Buffer
+			if err := writeDNSCheckJSON(&output, "example.test", result); err != nil {
+				t.Fatal(err)
+			}
+			var decoded map[string]json.RawMessage
+			if err := json.Unmarshal(output.Bytes(), &decoded); err != nil {
+				t.Fatal(err)
+			}
+			if string(decoded["Domain"]) != `"example.test"` {
+				t.Fatal("missing domain identity")
+			}
+			var diagnostics webadmin.Result
+			if err := json.Unmarshal(decoded[section], &diagnostics); err != nil {
+				t.Fatal(err)
+			}
+			if len(diagnostics.Errors) != 1 || diagnostics.Errors[0] != "missing DNS record" {
+				t.Fatal("native errors lost")
+			}
+			if len(diagnostics.Warnings) != 1 || diagnostics.Warnings[0] != "native warning" {
+				t.Fatal("native warnings lost")
+			}
+		})
+	}
+}
