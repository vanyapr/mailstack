# Local development only. Real installation uses HTTPS and a restricted gateway.
MAILSTACK_LOCAL=1
APP_ORIGIN=http://127.0.0.1:3100
MOX_ORIGIN=http://127.0.0.1:11080

# Optional durable private state; absolute path outside the repository, mode 0700.
# MAILSTACK_PUSH_DIR=/absolute/private/path/mailstack-push
# Opt in explicitly; unset/0 never creates keys or starts delivery.
MAILSTACK_PUSH_ENABLED=0
