+// ComposeFile is an attachment in a draft. Data uses standard JSON base64 bytes.
+type ComposeFile struct {
+	Filename    string
+	ContentType string
+	Data        []byte
+}
+
+// MessageComposeRich saves a complete MIME draft, replacing a previous draft in
+// the same transaction. Existing MessageCompose clients keep their old contract.
+func (w Webmail) MessageComposeRich(ctx context.Context, m ComposeMessage, mailboxID int64, htmlBody string, files []ComposeFile, forward bool) int64 {
+	if len(files) > 20 || len(htmlBody) > 2*1024*1024 || len(m.TextBody) > 1024*1024 {
+		xcheckuserf(ctx, errors.New("draft exceeds content limits"), "checking draft")
+	}
+	var size int
+	for _, file := range files {
+		size += len(file.Data)
+		if size > 15*1024*1024 {
+			xcheckuserf(ctx, errors.New("draft attachments exceed 15 MiB"), "checking draft")
+		}
+		if strings.TrimSpace(file.Filename) == "" || len([]rune(file.Filename)) > 255 || strings.ContainsAny(file.Filename, "/\\") {
+			xcheckuserf(ctx, errors.New("invalid attachment filename"), "checking draft")
+		}
+		for _, c := range file.Filename {
+			if c < 0x20 || c == 0x7f {
+				xcheckuserf(ctx, errors.New("control character in filename"), "checking draft")
+			}
+		}
+		if file.ContentType != "" {
+			_, _, err := mime.ParseMediaType(file.ContentType)
+			xcheckuserf(ctx, err, "checking attachment content-type")
+		}
+	}
+	return w.messageCompose(ctx, m, mailboxID, htmlBody, files, true, forward)
+}
+
+// DraftHTML returns the original HTML part for editing, never for direct rendering.
+// The caller must sanitize it. Only the authenticated account's Draft mailbox is read.
+func (Webmail) DraftHTML(ctx context.Context, msgID int64) (htmlBody string) {
+	reqInfo := ctx.Value(requestInfoCtxKey).(requestInfo)
+	acc, log := reqInfo.Account, reqInfo.Log
+	acc.WithRLock(func() {
+		xdbread(ctx, acc, func(tx *bstore.Tx) {
+			m := xmessageID(ctx, tx, msgID)
+			mb := xmailboxID(ctx, tx, m.MailboxID)
+			if !mb.Draft {
+				xcheckuserf(ctx, errors.New("message is not a draft"), "reading draft")
+			}
+			state := msgState{acc: acc}
+			defer state.clear()
+			pm, err := parsedMessage(log, &m, &state, true, false, false)
+			xcheckf(ctx, err, "parsing draft")
+			if !pm.HasHTML {
+				return
+			}
+			part := &pm.Part
+			for _, index := range pm.HTMLPath {
+				part = &part.Parts[index]
+			}
+			data, err := io.ReadAll(&moxio.LimitReader{R: part.ReaderUTF8OrBinary(), Limit: 2 * 1024 * 1024})
+			xcheckf(ctx, err, "reading draft html")
+			htmlBody = string(data)
+		})
+	})
+	return
+}
