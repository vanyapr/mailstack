+package imapserver
+
+import (
+	"encoding/base64"
+	"fmt"
+	"mime"
+	"testing"
+	"time"
+
+	"github.com/mjl-/mox/imapclient"
+)
+
+// RFC 9051 section 6.4.4 requires decoding MIME header strings before
+// comparing SEARCH text. These messages contain no real mailbox data.
+func TestSearchRFC2047Headers(t *testing.T) {
+	tc := start(t, false)
+	defer tc.close()
+	tc.login("mjl@mox.example", password0)
+	tc.client.Select("inbox")
+
+	bword := func(s string) string { return mime.BEncoding.Encode("utf-8", s) }
+	qword := func(s string) string { return mime.QEncoding.Encode("utf-8", s) }
+	messages := []struct {
+		subject, extra, body, transfer string
+	}{
+		{bword("Mailstack входящий тест"), "X-Note: =?ISO-8859-1?Q?Caf=E9?=\r\n", "ordinary body token", "8bit"},
+		{qword("Склад ") + "\r\n\t" + bword("Проверка"), "", "ordinary body token", "8bit"},
+		{"=?ISO-8859-1?Q?Caf=E9?=", "", base64.StdEncoding.EncodeToString([]byte("Тело кодировка")), "base64"},
+		{"prefix =?UTF-8?B?%%%?= rawtail", "X-Unknown: =?X-UNKNOWN?Q?rawtoken?=\r\nX-Note: first\r\nX-Note: " + bword("Сохранённый заголовок") + "\r\n", "ordinary body token", "8bit"},
+		{"ordinary subject", "", bword("ТолькоВТеле"), "8bit"},
+		{"Прямой UTF-8 заголовок", "", "ordinary body token", "8bit"},
+	}
+	for _, m := range messages {
+		msg := fmt.Sprintf("From: %s <sender@example.test>\r\nTo: receiver@example.test\r\nSubject: %s\r\n%sMIME-Version: 1.0\r\nContent-Type: text/plain; charset=utf-8\r\nContent-Transfer-Encoding: %s\r\n\r\n%s\r\n", bword("Иван Тест"), m.subject, m.extra, m.transfer, m.body)
+		tc.client.Append("inbox", makeAppendTime(msg, time.Now()))
+	}
+
+	checks := []struct {
+		uid   uint32
+		query string
+		match bool
+	}{
+		{1, `subject "mAiLsTaCk"`, true},
+		{1, `subject "ВХОДЯЩИЙ"`, true},
+		{1, `header subject "mailstack входящий тест"`, true},
+		{1, `text "mailstack входящий тест"`, true},
+		{1, `text "Subject: Mailstack"`, true},
+		{1, `body "Mailstack"`, false},
+		{1, `body "ordinary body"`, true},
+		{1, `not subject "ВХОДЯЩИЙ"`, false},
+		{1, `or subject "ВХОДЯЩИЙ" body "missing"`, true},
+		{1, `from "ИВАН"`, true},
+		{1, `header x-note "CAFÉ"`, true},
+		{1, `text "CAFÉ"`, true},
+		{1, `text "Mailstack" text "ordinary body"`, true},
+		{1, `text "ordinary body" not text "ВХОДЯЩИЙ"`, false},
+		{2, `subject "склад проверка"`, true},
+		{2, `header subject "склад проверка"`, true},
+		{2, `text "склад проверка"`, true},
+		{3, `subject "CAFÉ"`, true},
+		{3, `text "CAFÉ"`, true},
+		{3, `body "ТЕЛО КОДИРОВКА"`, true},
+		{4, `subject "rawtail"`, true},
+		{4, `header x-unknown "rawtoken"`, true},
+		{4, `text "rawtoken"`, true},
+		{4, `header x-note "СОХРАНЁННЫЙ"`, true},
+		{4, `text "СОХРАНЁННЫЙ"`, true},
+		{4, `header subject ""`, true},
+		{4, `header x-missing ""`, false},
+		{5, `body "ТолькоВТеле"`, false},
+		{5, `text "ТолькоВТеле"`, false},
+		{5, `body "=?utf-8?b?"`, true},
+		{6, `subject "ПРЯМОЙ"`, true},
+		{6, `text "ПРЯМОЙ"`, true},
+	}
+	for _, check := range checks {
+		t.Logf("UID %d SEARCH %s", check.uid, check.query)
+		tc.transactf("ok", "uid search charset utf-8 uid %d %s", check.uid, check.query)
+		if check.match {
+			tc.xsearch(check.uid)
+		} else {
+			tc.xsearch()
+		}
+	}
+
+	// Search-argument charsets retain the existing protocol validation.
+	tc.transactf("ok", `uid search charset us-ascii uid 1 subject "MAILSTACK"`)
+	tc.xsearch(1)
+	tc.transactf("no", `uid search charset unknown uid 1 subject "MAILSTACK"`)
