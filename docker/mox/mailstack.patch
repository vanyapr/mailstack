+package imapclient
+
+import (
+	"errors"
+	"io"
+	"log/slog"
+	"net"
+	"strings"
+	"testing"
+)
+
+type recoverTestConn struct {
+	net.Conn
+	reader     io.Reader
+	closeErr   error
+	closePanic any
+}
+
+func (c recoverTestConn) Read(p []byte) (int, error) { return c.reader.Read(p) }
+func (c recoverTestConn) Close() error {
+	if c.closePanic != nil {
+		panic(c.closePanic)
+	}
+	return c.closeErr
+}
+
+func TestCloseReturnsConnectionError(t *testing.T) {
+	for _, withHandler := range []bool{false, true} {
+		t.Run(map[bool]string{false: "without-handler", true: "with-handler"}[withHandler], func(t *testing.T) {
+			defer func() {
+				if p := recover(); p != nil {
+					t.Fatalf("Close panicked instead of returning an error: %v", p)
+				}
+			}()
+			want := errors.New("connection already closed by peer")
+			c := &Conn{Proto: Proto{conn: recoverTestConn{closeErr: want}}}
+			calls := 0
+			if withHandler {
+				c.errHandle = func(err error) {
+					calls++
+					if !errors.Is(err, want) {
+						t.Errorf("handler error %v, want %v", err, want)
+					}
+				}
+			}
+			if err := c.Close(); !errors.Is(err, want) {
+				t.Fatalf("Close error %v, want %v", err, want)
+			}
+			if withHandler && calls != 1 {
+				t.Fatalf("handler calls %d, want 1", calls)
+			}
+		})
+	}
+}
+
+func TestNewReturnsGreetingError(t *testing.T) {
+	for _, greeting := range []string{"", "invalid greeting\r\n"} {
+		t.Run(map[bool]string{true: "eof", false: "malformed"}[greeting == ""], func(t *testing.T) {
+			defer func() {
+				if p := recover(); p != nil {
+					t.Fatalf("New panicked instead of returning an error: %v", p)
+				}
+			}()
+			calls := 0
+			var handled error
+			opts := &Opts{Logger: slog.New(slog.NewTextHandler(io.Discard, nil)), Error: func(err error) {
+				calls++
+				handled = err
+			}}
+			c, err := New(recoverTestConn{reader: strings.NewReader(greeting)}, opts)
+			if c != nil || err == nil {
+				t.Fatalf("New = %v, %v, want nil client and error", c, err)
+			}
+			if calls != 1 || handled != err {
+				t.Fatalf("handler calls %d, error %v; want once with returned error %v", calls, handled, err)
+			}
+		})
+	}
+}
+
+func TestClosePreservesUnexpectedPanic(t *testing.T) {
+	want := "unexpected implementation panic"
+	defer func() {
+		if got := recover(); got != want {
+			t.Fatalf("panic %v, want %q", got, want)
+		}
+	}()
+	c := &Conn{Proto: Proto{conn: recoverTestConn{closePanic: want}}}
+	c.Close()
+	t.Fatal("unexpected panic was swallowed")
+}
