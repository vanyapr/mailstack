diff --git a/message/mailstack_subject_test.go b/message/mailstack_subject_test.go
new file mode 100644
--- /dev/null
+++ b/message/mailstack_subject_test.go
@@ -0,0 +1,28 @@
+package message
+
+import (
+    "bufio"
+    "bytes"
+    "mime"
+    "net/textproto"
+    "strings"
+    "testing"
+)
+
+func TestMailstackUnicodeSubjectRoundtrip(t *testing.T) {
+    subjects := []string{"Проверка интерфейса", "Привет  мир", "Re: Тест ответа", strings.Repeat("Длинная тема письма ", 25), "ASCII subject"}
+    for _, subject := range subjects {
+        t.Run(subject, func(t *testing.T) {
+            var b bytes.Buffer
+            composer := NewComposer(&b, 1024*1024, false)
+            composer.Subject(subject)
+            composer.Line()
+            composer.Flush()
+            header, err := textproto.NewReader(bufio.NewReader(&b)).ReadMIMEHeader()
+            if err != nil { t.Fatal(err) }
+            got, err := (&mime.WordDecoder{}).DecodeHeader(header.Get("Subject"))
+            if err != nil { t.Fatal(err) }
+            if got != subject { t.Fatalf("subject changed: got %q, want %q", got, subject) }
+        })
+    }
+}
diff --git a/message/compose.go b/message/compose.go
--- a/message/compose.go
+++ b/message/compose.go
@@ -112,0 +113,6 @@
+	if !xc.SMTPUTF8 && !isASCII(subject) {
+		// RFC 2047 ignores whitespace between adjacent encoded words. Encode
+		// the complete subject so its real spaces stay inside encoded words.
+		xc.Header("Subject", mime.QEncoding.Encode("utf-8", subject))
+		return
+	}
